CONFIG_IDF_TARGET="esp32s3"

# Flash et partitions (deux slots OTA de 3 Mo)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=n

# PSRAM utilisée si présente (modules N8R8 / N16R8), ignorée sinon
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Tampons Wi-Fi et lwIP en PSRAM : la RAM interne manquait (chiffrement AES matériel en
# échec, puis tas corrompu) pendant un téléchargement HTTPS avec l'interface en HTTPS.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Console sur l'UART0 (port USB "UART"/"COM") uniquement :
# GPIO19/20 (USB natif) sont utilisés pour le PN532.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Performances et robustesse
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# Une tâche bloquée provoque un redémarrage (et le retour à l'ancien firmware après une mise à jour)
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Carte SD : noms longs et accentués
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_850=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

# Serveur HTTP
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_HTTPD_PURGE_BUF_LEN=128

# Réseau
CONFIG_LWIP_MAX_SOCKETS=28
CONFIG_LWIP_LOCAL_HOSTNAME="enceinte"
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=4

# Interface web en HTTPS (option des réglages, certificat auto-signé)
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# Mises à jour : HTTPS recommandé, HTTP autorisé pour un serveur local
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Décodeurs audio inutiles désactivés (gain de place)
CONFIG_AUDIO_DECODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_DECODER_G711_SUPPORT=n

# Mémoire : tampons TLS alloués à la demande (mises à jour HTTPS), par malloc : les gros
# (16 Ko en réception) vont en PSRAM (seuil SPIRAM_MALLOC_ALWAYSINTERNAL), en RAM interne
# s'il n'y a pas de PSRAM. Forcés en RAM interne (réglage par défaut d'ESP-IDF), ils
# manquaient quand elle était morcelée : HTTPS de l'interface + mise à jour.
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
